# WireGuard — {{ inventory_hostname }} ({{ host }})
# Generated by rosctl @ {{ now() if now is defined else '' }}

# Создать интерфейс (идемпотентно: сначала удаляем старый)
/interface wireguard
remove [find name={{ wg_name | default('wg0') }}]
add name={{ wg_name | default('wg0') }} listen-port={{ wg_port | default(13231) }} private-key="{{ wg_private_key }}" mtu=1420 comment="managed by rosctl — {{ inventory_hostname }}"

# IP адрес
/ip address
remove [find interface={{ wg_name | default('wg0') }}]
add address={{ wg_address }} interface={{ wg_name | default('wg0') }} comment="wireguard {{ inventory_hostname }}"

# Пиры
/interface wireguard peers
{% for peer in peers | default([]) %}
add interface={{ wg_name | default('wg0') }} public-key="{{ peer.pubkey }}" allowed-address={{ peer.allowed }} endpoint-address={{ peer.endpoint }} endpoint-port={{ peer.port | default(13231) }} persistent-keepalive=25s comment="peer {{ loop.index }} — {{ peer.endpoint }}"
{% endfor %}

# Firewall для WG
/ip firewall filter
add chain=input action=accept protocol=udp dst-port={{ wg_port | default(13231) }} comment="rosctl: allow wireguard" place-before=0
