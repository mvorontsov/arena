# Base config — {{ inventory_hostname }} — {{ group }} — {{ host }}
# {{ ansible_managed if ansible_managed is defined else 'managed by rosctl' }}

/system identity set name={{ inventory_hostname }}
/system clock set time-zone-name={{ timezone | default('Europe/Moscow') }}
/system ntp client set enabled=yes

/ip dns set servers={{ dns_primary | default('1.1.1.1') }},{{ dns_secondary | default('8.8.8.8') }} allow-remote-requests=yes cache-size=2048KiB
/ip dns static add name={{ inventory_hostname }}.local address={{ host }} comment="self"

/interface bridge add name=bridge1 protocol-mode=rstp comment="defconf"
{% for port in bridge_ports | default(['ether2','ether3','ether4']) %}
/interface bridge port add bridge=bridge1 interface={{ port }}
{% endfor %}

/ip address add address=192.168.88.1/24 interface=bridge1 comment="defconf"
{% if mgmt_vlan is defined %}
/interface vlan add name=vlan{{ mgmt_vlan }} vlan-id={{ mgmt_vlan }} interface=bridge1
/ip address add address={{ mgmt_ip }} interface=vlan{{ mgmt_vlan }}
{% endif %}

/ip firewall filter
add chain=input action=accept connection-state=established,related comment="rosctl: established"
add chain=input action=drop connection-state=invalid
add chain=input action=accept protocol=icmp comment="allow ping"
add chain=input action=drop in-interface-list=!LAN comment="defconf: drop !LAN"

/system backup save name={{ inventory_hostname }}_autosave
