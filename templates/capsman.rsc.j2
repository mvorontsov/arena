# CAPsMAN — {{ inventory_hostname }}
/interface wifi
# SSID: {{ ssid | default('Retail-WiFi') }} band: {{ band | default('5ghz-ax') }}
add name={{ ssid | lower | replace(' ', '-') | replace('_','-') }} configuration.mode=ap ssid="{{ ssid }}" configuration.band={{ band }} disabled=no comment="rosctl managed"

# VLAN привязанный
{% if vlan_id is defined %}
/interface bridge vlan
add bridge=bridge1 vlan-ids={{ vlan_id }} tagged=bridge1,ether1 untagged=wifi1 comment="vlan {{ vlan_id }}"
{% endif %}
