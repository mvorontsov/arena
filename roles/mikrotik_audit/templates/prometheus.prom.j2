# Prometheus exposition для {{ inventory_hostname }} — generated by Ansible audit
# TYPE mikrotik_audit_compliance gauge
mikrotik_audit_compliance{hostname="{{ inventory_hostname }}",board="{{ audit_report.board }}",version="{{ audit_report.routeros_version }}"} {{ audit_report.compliance.pct }}
mikrotik_audit_passed{hostname="{{ inventory_hostname }}"} {{ audit_report.compliance.passed }}
mikrotik_audit_failed{hostname="{{ inventory_hostname }}"} {{ audit_report.compliance.failed }}
# TYPE mikrotik_audit_severity gauge
mikrotik_audit_critical{hostname="{{ inventory_hostname }}"} {{ audit_report.compliance.critical }}
mikrotik_audit_high{hostname="{{ inventory_hostname }}"} {{ audit_report.compliance.high }}
mikrotik_audit_medium{hostname="{{ inventory_hostname }}"} {{ audit_report.compliance.medium }}
mikrotik_audit_low{hostname="{{ inventory_hostname }}"} {{ audit_report.compliance.low }}
# TYPE mikrotik_audit_check gauge (1=fail, 0=pass)
{% for f in audit_report.findings %}
mikrotik_audit_check{hostname="{{ inventory_hostname }}",id="{{ f.id }}",category="{{ f.category }}",severity="{{ f.severity }}"} 1
{% endfor %}
{% for pid in audit_report.passed_ids %}
mikrotik_audit_check{hostname="{{ inventory_hostname }}",id="{{ pid }}"} 0
{% endfor %}
# TYPE mikrotik_info gauge
mikrotik_info{hostname="{{ inventory_hostname }}",board="{{ audit_report.board }}",version="{{ audit_report.routeros_version }}",location="{{ audit_report.meta.location }}"} 1
